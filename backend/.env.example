# ─────────────────────────────────────────────────────────────────
# SALUX BACKEND — Variables de entorno (SOLO DESARROLLO LOCAL)
# Copiá este archivo a .env y completalo con tus valores.
# NUNCA commitees el archivo .env al repositorio.
#
# ⚠ ESTE .env ES PARA TU MÁQUINA. Los secretos de PRODUCCIÓN (Vercel) tienen que ser
#   DISTINTOS: generalos con `npm run secretos` y cargalos solo en Vercel. Así, si este
#   archivo se filtra (o se sincroniza a una nube, como OneDrive), producción no se ve
#   afectada. Conviene además tener el proyecto FUERA de carpetas sincronizadas.
#
# Quién usa cada variable:
#   · El contenedor del backend recibe SOLO lo que necesita (lista explícita en el
#     docker-compose.yml): base de datos, JWT, CORS, SMTP, límites. No recibe ADMIN_*,
#     PRUEBA_* ni POSTGRES_PASSWORD.
#   · ADMIN_* y PRUEBA_* los leen únicamente los scripts que corrés en tu máquina
#     (crearAdmin.js, seedDemo.js).
#   · POSTGRES_PASSWORD y DB_APP_* los usa docker-compose para crear la base local.
# ─────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL) ─────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Local (Docker): el rol `salux_app` lo crea docker-compose a partir de DB_APP_*.
DATABASE_URL="postgresql://salux_app:CAMBIA_ESTA_CONTRASEÑA_APP@localhost:5432/salux_db"
# Conexión para migraciones (prisma migrate). Local: la misma. En Supabase: el
# "Session pooler" (puerto 5432); DATABASE_URL pasa a ser el "Transaction pooler"
# (puerto 6543, con ?pgbouncer=true&connection_limit=1). Ver docs/DESPLIEGUE.md.
DIRECT_URL="postgresql://salux_app:CAMBIA_ESTA_CONTRASEÑA_APP@localhost:5432/salux_db"

# ── PostgreSQL (solo para docker-compose) ──────────────────────────
# Superusuario del servidor: solo para administrarlo, la app NO lo usa.
POSTGRES_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"
# Rol de la aplicación: dueño de salux_db y nada más.
DB_APP_USER="salux_app"
DB_APP_PASSWORD="CAMBIA_ESTA_CONTRASEÑA_APP"

# ── JWT ────────────────────────────────────────────────────────────
# Generá valores aleatorios con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERA_UN_STRING_ALEATORIO_DE_64_BYTES_AQUI"
JWT_REFRESH_SECRET="GENERA_OTRO_STRING_ALEATORIO_DE_64_BYTES_AQUI"

# ── Servidor ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Proxy inverso ──────────────────────────────────────────────────
# Cuántos proxies hay delante del servidor (Nginx, Render, Railway...).
# Dejar vacío si el servidor se expone directo: confiar en un proxy que no
# existe permite falsificar la IP con X-Forwarded-For y evadir los límites.
TRUST_PROXY=

# ── CORS ───────────────────────────────────────────────────────────
# URL(s) del frontend autorizadas a consumir la API, separadas por coma.
# Si se deja vacío, se permite cualquier origen (solo recomendado en desarrollo).
CORS_ORIGIN="http://localhost:5173"

# ── Seed del Administrador inicial ─────────────────────────────────
# Usados SOLO por el script crearAdmin.js, no en producción
ADMIN_EMAIL="admin@salux.com"
ADMIN_PASSWORD="CAMBIA_ESTA_CONTRASEÑA_ADMIN"
ADMIN_NOMBRE="Nombre Apellido"
ADMIN_DNI="00000000"

# ── Email (SMTP) ────────────────────────────────────────────────────
# Opcional: si se deja sin completar, el envío de emails se omite (se
# loguea en consola) sin romper el resto de la app.
# Con Gmail: SMTP_USER es tu cuenta, SMTP_PASS es una "contraseña de
# aplicación" de 16 caracteres (myaccount.google.com > Seguridad >
# Contraseñas de aplicaciones) — la contraseña normal de la cuenta NO
# funciona, Gmail la bloquea para SMTP desde 2022.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="CAMBIA_ESTA_CONTRASEÑA_DE_APLICACION"
EMAIL_FROM="Salux <tu-cuenta@gmail.com>"

# ── Cuentas de prueba para QA manual (opcional, solo desarrollo) ───
# Usuarios de ejemplo para recorrer la app como médico y como paciente.
# Se crean desde la UI (admin > "+ Especialidad / Médico" y "Crear una cuenta").
PRUEBA_MEDICO_EMAIL="medico.prueba@salux.com"
PRUEBA_MEDICO_DNI="30222333"
PRUEBA_MEDICO_MATRICULA="MP-QA-001"
PRUEBA_MEDICO_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"
PRUEBA_PACIENTE_EMAIL="paciente.prueba@salux.com"
PRUEBA_PACIENTE_DNI="40111222"
PRUEBA_PACIENTE_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"

# ── Redis (límites de intentos compartidos) ────────────────────────
# Con docker-compose se levanta solo; define la contraseña de ese Redis.
# Si corrés el backend sin Docker, podés definir REDIS_URL=redis://:clave@host:6379
# (sin REDIS_URL los contadores quedan en memoria: sirven para una sola instancia).
REDIS_PASSWORD="CAMBIA_ESTA_CONTRASEÑA_REDIS"

# ── Seguridad de cuentas ───────────────────────────────────────────
# true: una cuenta nueva no puede ingresar hasta confirmar su email, y el
# registro responde igual exista o no el email/DNI (no revela cuentas).
# Requiere SMTP funcionando. Recomendado en producción.
REQUIERE_VERIFICACION_EMAIL=false
# En producción (NODE_ENV=production) el servidor redirige a HTTPS; poner false
# solo si algo antes del servidor ya lo hace.
FORZAR_HTTPS=true

# ── Despliegue en Vercel (ver docs/DESPLIEGUE.md) ───────────────────────────
# Dónde guardar los contadores de los límites de intentos:
#   (vacío)  memoria: sirve para una sola instancia (desarrollo)
#   db       en la base de datos: necesario en Vercel (serverless)
#   (o definí REDIS_URL para usar Redis)
RATE_LIMIT_STORE=
# Secreto que Vercel Cron manda a /api/cron/mantenimiento. Sin él la ruta queda deshabilitada.
CRON_SECRET=

# ── Límites anti-abuso (todos opcionales: estos son los valores por defecto) ──
# Máximo de contraseñas incorrectas por cuenta cada 15 min, desde cualquier IP.
LOGIN_FALLOS_POR_CUENTA=30
# Correos que puede disparar cualquiera sin iniciar sesión (recuperar contraseña,
# reenviar verificación): espera mínima entre dos al mismo correo, tope por día y
# por dirección, y presupuesto diario global (el plan gratis de Brevo permite 300/día).
CORREO_ESPERA_MINUTOS=5
CORREOS_POR_DIA_Y_DIRECCION=6
CORREOS_ABUSABLES_POR_DIA=100
# Límite general de la API por IP cada 15 min.
API_LIMITE_PETICIONES=300
# true: deja el límite general en memoria de cada instancia en vez de la base (solo si el
# costo de una escritura por petición fuera un problema; en Vercel pierde efecto real).
API_RATE_LIMIT_MEMORIA=
